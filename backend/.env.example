# Copia este archivo a `.env` y sustituye los valores correspondientes.
# No subas `.env` al repositorio.

# Puerto del servidor
PORT=5000

# URI de conexión a MongoDB (puedes usar MONGO_URI o MONGODB_URI)
# Para MongoDB local:
MONGO_URI=mongodb://127.0.0.1:27017/mern_practice

# Para MongoDB Atlas (despliegue en Vercel):
# MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/nombre_db?retryWrites=true&w=majority

# Nombre de la base de datos (opcional, si no está en la URI)
# MONGO_DB_NAME=Practice

# Token de escritura de Vercel Blob Storage (OBLIGATORIO para adjuntos).
# Se obtiene en Vercel: proyecto -> Storage -> tu Blob Store -> .env.local
# En producción Vercel lo inyecta automáticamente al vincular el store.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Secreto para firmar los tokens JWT de sesión (cámbialo en producción).
AUTH_SECRET=cambia-este-secreto

# Cuenta administrador hardcodeada (todos los privilegios).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cambia-esta-clave